{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
  ],
  "compilerOptions": {
    "types": ["@remix-run/node", "vite/client"],
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",

    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@/*": ["./app/*"],
    },
  },
}
